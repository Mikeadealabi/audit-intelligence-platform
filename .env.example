# Local development only. Copy to .env and fill in. Never commit real secrets.
# Production secrets belong in a managed secret store, not a .env file.

DATABASE_URL=postgresql+psycopg://audit:audit@localhost:5460/audit_dev
JWT_SECRET=replace-with-a-long-random-value-for-local-dev-only
JWT_EXPIRE_MINUTES=60
LOCAL_STORAGE_DIR=./local_storage
MAX_UPLOAD_BYTES=10485760
MAX_ROWS_PER_IMPORT=50000

# --- Data handling hardening ---
# Fernet key encrypting uploaded file bytes and raw_row content at rest. Generate
# your own with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never reuse the repo's dev default outside local dev. Rotating this key makes
# all previously written ciphertext permanently unreadable (no key-versioning in
# this slice) — see docs/deployment-runbook.md.
FILE_ENCRYPTION_KEY=VcetRONpqI6CKNxcvtP23IPpSIU9GSk5hvNmNxrBQnk=
# Only set true once this app is confirmed to be running behind a real
# TLS-terminating reverse proxy. Leave false for local dev (plain HTTP).
ENABLE_HSTS=false

# --- Nigerian compliance placeholders (NOT enforced by any code) ---
# These exist so rule values are configurable, not hard-coded, once a control that
# needs them is built. They are unverified. Confirm current rates with a qualified
# Nigerian tax/compliance professional before relying on them for anything real.
VAT_RATE_PERCENT=7.5
# WHT_RATE_TABLE / PAYE_BANDS intentionally left unset here — model as PolicyVersion
# rows in the database (see docs/data-dictionary.md), not environment variables, once
# that table exists. Do not hard-code them in application code.

# --- Claude-assisted investigation (Phase 5) ---
# Leave both unset to disable investigation requests (they return 503, never a fake
# result). Model ID has no code default on purpose — pick a current model ID from
# https://platform.claude.com/docs (see docs/claude-tool-contract.md) rather than
# trust a value baked into this file.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_ID=
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_TOOL_TURNS=6
LLM_MAX_TOOL_RESULT_RECORDS=25
LLM_MAX_INVESTIGATIONS_PER_TENANT_PER_DAY=50
